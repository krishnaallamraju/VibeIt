{
  "name": "pocketband-client",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node -e \"const fs=require('fs'); if(fs.existsSync('public/VibeIt.apk')) fs.copyFileSync('public/VibeIt.apk', 'dist/VibeIt.apk');\"",
    "cap:sync": "cap sync android",
    "build:apk": "expo export --platform web && cap sync android && cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@expo/metro-runtime": "~3.2.3",
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "lucide-react": "^0.378.0",
    "qrcode.react": "^3.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.1",
    "react-native-web": "~0.19.10",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.45",
    "typescript": "^5.3.0"
  },
  "private": true
}
