{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"VibeItzzz.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/VibeItzzz.apk",
      "dest": "/VibeItzzz.apk"
    },
    {
      "src": "/VibeIt.apk",
      "dest": "/VibeIt.apk"
    },
    {
      "src": "/download-apk",
      "dest": "/VibeItzzz.apk"
    },
    {
      "src": "/apk",
      "dest": "/VibeItzzz.apk"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
